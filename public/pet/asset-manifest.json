{
  "schemaVersion": 1,
  "id": "xiaoman",
  "displayName": "小满",
  "spriteVersionNumber": 2,
  "replacementRoot": "public/pet",
  "entries": [
    {
      "id": "codex-pet",
      "label": "原生 Codex 元数据",
      "kind": "metadata",
      "sourcePath": "public/pet/native/pet.json",
      "packagePath": "assets/codex/pet.json",
      "required": true,
      "profile": "native",
      "notes": "导出到 Codex 时覆盖 ~/.codex/pets/<id>/pet.json。"
    },
    {
      "id": "codex-spritesheet",
      "label": "原生 Codex 动作图集",
      "kind": "spritesheet",
      "sourcePath": "public/pet/native/spritesheet.webp",
      "packagePath": "assets/codex/spritesheet.webp",
      "required": true,
      "profile": "native",
      "width": 1536,
      "height": 2288,
      "frameCount": 88,
      "columns": 8,
      "rows": 11,
      "notes": "Codex 兼容导出的第二个文件；与 codex-pet 配对。"
    },
    {
      "id": "native-look-atlas",
      "label": "原生 16 方向注视图集",
      "kind": "look-atlas",
      "sourcePath": "public/pet/native/look-16.webp",
      "packagePath": "assets/native/look-16.webp",
      "required": true,
      "profile": "native",
      "width": 1536,
      "height": 416,
      "frameCount": 16,
      "columns": 8,
      "rows": 2,
      "notes": "原生 Codex profile 的 360 度离散方向。"
    },
    {
      "id": "native-look-metadata",
      "label": "原生注视元数据",
      "kind": "metadata",
      "sourcePath": "public/pet/native/look-16.json",
      "packagePath": "assets/native/look-16.json",
      "required": true,
      "profile": "native"
    },
    {
      "id": "enhanced-pet",
      "label": "增强 profile 元数据",
      "kind": "metadata",
      "sourcePath": "public/pet/pet.json",
      "packagePath": "assets/desktop/pet.json",
      "required": true,
      "profile": "enhanced"
    },
    {
      "id": "enhanced-spritesheet",
      "label": "增强标准动作图集",
      "kind": "spritesheet",
      "sourcePath": "public/pet/spritesheet.webp",
      "packagePath": "assets/desktop/spritesheet.webp",
      "required": true,
      "profile": "enhanced",
      "width": 1536,
      "height": 2288,
      "frameCount": 88,
      "columns": 8,
      "rows": 11,
      "notes": "标准待机、工作、等待、失败、跑动和跳跃动作。"
    },
    {
      "id": "enhanced-look-atlas",
      "label": "增强 96 方向注视图集",
      "kind": "look-atlas",
      "sourcePath": "public/pet/look-96.webp",
      "packagePath": "assets/desktop/look-96.webp",
      "required": true,
      "profile": "enhanced",
      "width": 2304,
      "height": 1664,
      "frameCount": 96,
      "columns": 12,
      "rows": 8,
      "notes": "每 3.75 度一个完整身体方向帧，不使用透明混合。"
    },
    {
      "id": "enhanced-look-metadata",
      "label": "增强注视元数据",
      "kind": "metadata",
      "sourcePath": "public/pet/look-96.json",
      "packagePath": "assets/desktop/look-96.json",
      "required": true,
      "profile": "enhanced"
    },
    {
      "id": "idle-actions",
      "label": "待机动作图集",
      "kind": "action-atlas",
      "sourcePath": "public/pet/idle-actions-30.webp",
      "packagePath": "assets/desktop/idle-actions-30.webp",
      "required": true,
      "profile": "enhanced",
      "width": 1920,
      "height": 1872,
      "frameCount": 90,
      "columns": 10,
      "rows": 9,
      "notes": "行 0-2 舔嘴，行 3-5 眨眼，行 6-8 举起前爪；每个动作 30 帧。"
    },
    {
      "id": "idle-actions-metadata",
      "label": "待机动作元数据",
      "kind": "metadata",
      "sourcePath": "public/pet/idle-actions-30.json",
      "packagePath": "assets/desktop/idle-actions-30.json",
      "required": true,
      "profile": "enhanced"
    },
    {
      "id": "sleeping-actions",
      "label": "蜷睡动作图集",
      "kind": "action-atlas",
      "sourcePath": "public/pet/sleeping-30.webp",
      "packagePath": "assets/desktop/sleeping-30.webp",
      "required": true,
      "profile": "enhanced",
      "width": 1920,
      "height": 624,
      "frameCount": 30,
      "columns": 10,
      "rows": 3,
      "notes": "完整身体蜷缩睡眠循环；睡眠时不拼接头部。"
    },
    {
      "id": "sleeping-actions-metadata",
      "label": "蜷睡动作元数据",
      "kind": "metadata",
      "sourcePath": "public/pet/sleeping-30.json",
      "packagePath": "assets/desktop/sleeping-30.json",
      "required": true,
      "profile": "enhanced"
    },
    {
      "id": "care-actions",
      "label": "喂食与洗澡动作图集",
      "kind": "action-atlas",
      "sourcePath": "public/pet/care-actions-30.webp",
      "packagePath": "assets/desktop/care-actions-30.webp",
      "required": true,
      "profile": "enhanced",
      "width": 1920,
      "height": 1248,
      "frameCount": 60,
      "columns": 10,
      "rows": 6,
      "notes": "行 0-2 洗澡，行 3-5 喂食/礼包反馈；每个动作 30 帧。"
    },
    {
      "id": "care-actions-metadata",
      "label": "喂食与洗澡元数据",
      "kind": "metadata",
      "sourcePath": "public/pet/care-actions-30.json",
      "packagePath": "assets/desktop/care-actions-30.json",
      "required": true,
      "profile": "enhanced"
    },
    {
      "id": "avatar",
      "label": "头像",
      "kind": "avatar",
      "sourcePath": "public/pet/avatar.png",
      "packagePath": "assets/desktop/avatar.png",
      "required": true,
      "width": 128,
      "height": 128
    },
    {
      "id": "tray",
      "label": "菜单栏图标",
      "kind": "tray",
      "sourcePath": "public/pet/tray.png",
      "packagePath": "assets/desktop/tray.png",
      "required": true,
      "width": 32,
      "height": 32
    }
  ]
}
